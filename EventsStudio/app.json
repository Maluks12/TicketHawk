{
  "expo": {
    "name": "TicketHawk Studio",
    "slug": "EventsStudio",
    "scheme": "tickethawkstudio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tickethawk.studio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08080C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tickethawk.studio",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan ticket QR codes at the door.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#08080C"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a156487c-a808-4812-ba00-d32427177555"
      }
    }
  }
}