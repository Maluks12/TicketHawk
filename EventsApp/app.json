{
  "expo": {
    "name": "TicketHawk",
    "slug": "EventsApp",
    "scheme": "eventsapp",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tickethawk.app",
      "associatedDomains": [
        "applinks:ticket-hawk.com",
        "applinks:www.ticket-hawk.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.1095131355111-6ctugf93micfuah5uvn9bn7k3gdas3kv"
            ]
          }
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1d1d29",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tickethawk.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ticket-hawk.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "ticket-hawk.com",
              "pathPrefix": "/booking"
            },
            {
              "scheme": "https",
              "host": "www.ticket-hawk.com",
              "pathPrefix": "/events"
            },
            {
              "scheme": "https",
              "host": "www.ticket-hawk.com",
              "pathPrefix": "/booking"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TicketHawk to use your location to show events happening near you.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1d1d29",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-apple-authentication",
        [
          "@react-native-google-signin/google-signin",
          {
            "iosUrlScheme": "com.googleusercontent.apps.1095131355111-6ctugf93micfuah5uvn9bn7k3gdas3kv"
          }
        ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5bc9023-b3dc-40c9-b045-c3c88884cb45"
      },
      "googleIosClientId": "1095131355111-6ctugf93micfuah5uvn9bn7k3gdas3kv.apps.googleusercontent.com",
      "googleAndroidClientId": "1095131355111-sm7epntca8otsh2na7o37hodftqso934.apps.googleusercontent.com",
      "googleWebClientId": "1095131355111-qp85blgedorjjtkbu5qqdc89bii8qsr3.apps.googleusercontent.com"
    }
  }
}
